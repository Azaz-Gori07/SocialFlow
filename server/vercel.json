{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/x_compat.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/x-compat",
      "dest": "api/x_compat.py"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ]
}
