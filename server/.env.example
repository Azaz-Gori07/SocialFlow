PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/socialflow
JWT_SECRET=your_jwt_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_32_chars_minimum
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:5173
# Canonical server URL — used to build provider OAuth redirect URIs (exact
# match with the provider's registered Callback URI: localhost ≠ 127.0.0.1).
# Keep in sync with the address the API is actually served on.
BACKEND_URL=http://localhost:5000
CORS_ORIGINS=
OPENROUTER_API_KEY=your_ai_provider_key
OPENROUTER_API_KEY_MODEL=your_provider_model
# Optional: point at any OpenAI-compatible endpoint (e.g. z.ai GLM: https://api.z.ai/api/paas/v4/chat/completions)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_2_MODEL=
ZENUXS_CLIENT_ID=
ZENUXS_CLIENT_SECRET=
ZENUXS_AUTH_SERVER=https://api.auth.zenuxs.in
EMAIL_USER=
EMAIL_PASS=
OTP_EXPIRY_MINUTES=10
OTP_EMAIL_HOST=
OTP_EMAIL_PORT=587
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret
FACEBOOK_LOGIN_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
Threads_CLIENT_ID=your_threads_app_id
Threads_CLIENT_SECRET=your_threads_app_secret
DEVELOPER_FLOW_ENABLED=false
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_WEBHOOK_SECRET=your_webhook_secret