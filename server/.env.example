# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development            # development | test | production

# ── Database ──────────────────────────────────────────────────────────────────
# MONGO_URI is required. Use MONGODB_URL as an alias.
MONGO_URI=

# ── Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ──
JWT_SECRET=                       # required, >= 32 chars
JWT_REFRESH_SECRET=               # required, >= 32 chars, distinct from JWT_SECRET
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ── Token encryption (required in production, >= 32 chars; same generation command) ──
# In development, ENCRYPTION_KEY may be omitted: a key is derived from JWT_SECRET.
ENCRYPTION_KEY=

# ── App URLs ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
# Comma-separated list of allowed CORS origins. Defaults to FRONTEND_URL.
CORS_ORIGINS=

# ── AI Service Configuration ──────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_MODEL=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_2_MODEL=
OPENAI_API_KEY=
CLAUDE_API_KEY=

# ── Auth OAuth (Zenuxs, used for login with Google/GitHub) ───────────────────
ZENUXS_CLIENT_ID=
ZENUXS_CLIENT_SECRET=
ZENUXS_AUTH_SERVER=https://api.auth.zenuxs.in

# ── Email (OTP delivery) ──────────────────────────────────────────────────────
EMAIL_USER=
EMAIL_PASS=
OTP_EXPIRY_MINUTES=10
OTP_EMAIL_HOST=
OTP_EMAIL_PORT=587
OTP_EMAIL_USER=
OTP_EMAIL_PASS=

# ── Social Media OAuth Credentials (create an app at each provider's developer console) ──
# X / Twitter
X_CLIENT_ID=
X_CLIENT_SECRET=
# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Facebook + Instagram (Meta App; Instagram uses the same app when in "Instagram API with Facebook Login" mode)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# Meta webhooks (verify token chosen by you; app secret from the Meta App dashboard)
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_SECRET=
# Not yet wired (reserved)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# ── Developer Intelligence (feature-gated; routes 404 unless 'true') ───────────
# Master switch for the whole module. Any value other than 'true' keeps it off.
DEVELOPER_FLOW_ENABLED=false
# GitHub OAuth App (needed to connect accounts and read repos)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Shared secret for verifying inbound GitHub webhook signatures
GITHUB_WEBHOOK_SECRET=
